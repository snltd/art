!!! html
%html{lang: 'en'}
  %head
    %meta{charset: 'utf-8'}

    -if @pg_title
      %title Robert Fisher // #{@pg_title}
    -else
      %title Robert Fisher

    %meta{name: 'description', content: 'conceptual painting'}
    %meta{name: 'author', content: 'Robert Fisher'}
    %meta{name: 'viewport', content: 'width=device-width, initial-scale=1'}
    //%link{href: 'http://fonts.googleapis.com/css?family=Old+Standard+TT:400,700,400italic', rel: 'stylesheet'}
    %link{href: 'http://fonts.googleapis.com/css?family=Roboto+Slab:300,700', rel: 'stylesheet'}
    %link{href: 'http://fonts.googleapis.com/css?family=Roboto:400,400italic', rel: 'stylesheet'}
    %link{href: 'http://fonts.googleapis.com/css?family=Source+Code+Pro:400', rel: 'stylesheet', type: 'text/css'}
    %script{type: 'text/javascript', src: '/js/jquery.min.js'}
    %script{type: 'text/javascript', src: '/js/jquery.tooltipster.min.js'}
    %link{href: '/css/tooltipster.css', rel: 'stylesheet', type: 'text/css'}
    %link{href: '/css/main.css', rel: 'stylesheet'}
    -if @extra_css
      -@extra_css.each do |c|
        %link{href: "/css/#{c}.css", rel: 'stylesheet', type: 'text/css'}
    :javascript
      $(document).ready(function() { $('.tooltip').tooltipster(); });

  %body
    = haml :partial_navbar

    #container
      =yield

      -unless @nofooter
        #footer
          &copy; 2014 Robert Fisher
