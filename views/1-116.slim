- @pg_title = '1-116'
- @extra_css = %w(116)

h1
  | &#8220;
  = @pg_title
  | &#8221;

markdown:
  *1-116* is a single piece of work, composed of one-hundred-and-sixteen
  pictures, each of which was made in a single day.

#cellscape
  table
    -col = 0
    -if @layout == 'by_date'
      tr
        -%w(Mon Tue Wed Thur Fri Sat Sun).each do |day|
          th
            = day
      - while @info.length > 0
        tr
          - 1.upto(7) do |dow|
            - if @info.first && @info.first[:dow] == dow
              - cell = @info.shift
              td
                == render(:slim,
                  :partial_116_thumb,
                  locals: {cell: cell, size: 'large'})
            - else
              td

    -elsif @layout == 'by_number'
      -@info.each_slice(@numcols) do |row|
        tr
          -row.each do |cell|
            td
              == render(:slim,
                :partial_116_thumb,
                locals: {cell: cell, size: 'large'})
    -else
      - 1.upto(11) do |row|
        tr
          - 1.upto(18) do |col|
            td
              - cell = @info.select{|x| x[:row] == row && x[:col] == col}.first
              - if cell
                == render(:slim,
                  :partial_116_thumb,
                  locals: {cell: cell, size: 'small'})
              -elsif col == 1
                | &nbsp;

- unless @layout || @info.length != 116
  markdown:
    The concept for each picture began with a randomly selected number
    from one to 116 inclusive. [The first
    forty-nine](/series/1-116/42/by_date) were made in seven weeks in
    2006 and later [compiled into a book](/series/1-116/extras/book).
    The [remaining sixty-seven pieces](/series/1-116/58/by_date) were
    made in sixty-seven consecutive days in 2008. [Strict
    rules](/series/1-116/extras/rules) applied.

== slim :partial_116_nav
