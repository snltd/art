- @extra_css = %w(piece_116 116)

h1
  | &#8220;
  == @info[:title]
  | &#8221;

#lbar
  #picnumber = @info[:number]

  #bigpicinfo
    .picmedium = @info[:medium]
    .picsize = "#{@info[:x]} x #{@info[:y]}cm"
    .picdate =  DateTime.new(@info[:year], @info[:month],
                             @info[:day]).strftime("%-d %B %Y")

    -if @info[:extra]
      - @info[:extra].each do |row|
        = row

    -if @info[:person]
      = "(#{@info[:person]})"

#bigpic
  img.bigpic src="/i/big/1-116/#{@info[:image]}" alt=@info[:title]

-if @info[:desc]
  .picdesc == markdown @info[:desc]

#prevnext
  - if @links[:by_num][:prev] >= 1
    a href="/piece/series/1-116/#{@links[:by_num][:prev]}"
      ' previous by number /

  - if @links[:by_num][:next] <= 116
    a href="/piece/series/1-116/#{@links[:by_num][:next]}"
      ' next by number /

  - if @links[:by_date][:prev]
    a href="/piece/series/1-116/#{@links[:by_date][:prev]}"
      ' previous by date
    - if @links[:by_date][:next]
      ' /

  - if @links[:by_date][:next]
    a href="/piece/series/1-116/#{@links[:by_date][:next]}"
      ' next by date

== slim :partial_116_nav
