- map = { '1-116 in periodic table form' => '/',
  '42% in periodic table form'   => '/42',
  '58% in periodic table form'   => '/58',
  '1-116 by number'              => '/all/by_number',
  '42% by number'                => '/42/by_number',
  '58% by number'                => '/58/by_number',
  '1-116 by date'                => '/all/by_date',
  '42% by date'                  => '/42/by_date',
  '58% by date'                  => '/58/by_date' }

#layouts
  - map.each_slice(3) do |row|
    .row
      - row.each_with_index do |data, index|
        -if data.last == @nomatch
          span.here
            => data.first
        -else
          a href="/series/1-116#{data.last}"
            => data.first
        -unless index == row.length - 1
          ' /

#number_links
  - 1.upto(116) do |num|
    a href="/piece/series/1-116/#{num}"
      = num
      | &nbsp;
    -unless num == 116
      ' /
